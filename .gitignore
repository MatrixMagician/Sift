.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/

# Local working documents — deliberately not published.
# Root-anchored: .claude/CLAUDE.md is tracked and must stay so.
/CLAUDE.md
/SPEC.md

# Per-run scratch left by tooling. Never durable planning state — unlike the
# rest of .planning/, which is tracked on purpose as a historical record.
/.planning/tmp/

# Generated knowledge-graph output (/graphify). Rebuilt from the
# codebase on demand, multi-megabyte, and churns on every build — derived
# artefacts, not source.
/.planning/graphs/
/graphify-out/

# Research-agent web-fetch digest cache (TTL'd, machine-local). The .md research
# documents in .planning/research/ ARE tracked on purpose; only this cache is
# derived. Path-anchored so it can never mask a tracked .cache elsewhere.
/.planning/research/.cache/

# Editor-local MCP/server wiring: absolute paths to this machine's binaries, so
# it is environment config rather than shared source. Path-anchored so a tracked
# .vscode/ elsewhere in the tree could never be masked.
/.vscode/

# ── Retired GSD workflow tooling ──
# Sift no longer uses GSD (see .claude/CLAUDE.md "Workflow"). These patterns
# stay so that if the tooling is ever run here again — by habit or by a fleet-
# wide script — its runtime state cannot land in the repo. .mcp.json is listed
# because GSD wrote its MCP server + write-gate wiring there; this project's
# MCP servers come from ~/.claude.json instead.
.gsd
.gsd-worktrees/
.gsd-backups/
.gsd-id
.mcp.json
.bg-shell/
.DS_Store
Thumbs.db
nul
nul.*
con
con.*
prn
prn.*
aux
aux.*
com[1-9]
com[1-9].*
