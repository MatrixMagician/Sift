.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/

# Local working documents — deliberately not published.
# Root-anchored: .claude/CLAUDE.md is tracked and must stay so.
/CLAUDE.md
/SPEC.md

# Per-run scratch from GSD workflows (docs-update manifests, verifier JSON).
# Refills on every run and is never durable planning state — unlike the rest
# of .planning/, which is tracked on purpose.
/.planning/tmp/

# Generated knowledge-graph output (/gsd-graphify, /graphify). Rebuilt from the
# codebase on demand, multi-megabyte, and churns on every build — derived
# artefacts, not source.
/.planning/graphs/
/graphify-out/

# Research-agent web-fetch digest cache (TTL'd, machine-local). The .md research
# documents in .planning/research/ ARE tracked on purpose; only this cache is
# derived. Path-anchored so it can never mask a tracked .cache elsewhere.
/.planning/research/.cache/

# Editor-local MCP/server wiring: absolute paths to this machine's binaries, so
# it is environment config rather than shared source. Path-anchored so a tracked
# .vscode/ elsewhere in the tree could never be masked.
/.vscode/

